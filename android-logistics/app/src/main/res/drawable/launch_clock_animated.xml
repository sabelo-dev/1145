<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the load animation's first frame with its breathing halo. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_clock">
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
            <objectAnimator android:propertyName="scaleX" android:valueFrom="0.96" android:valueTo="1.04"
                android:duration="1200" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
            <objectAnimator android:propertyName="scaleY" android:valueFrom="0.96" android:valueTo="1.04"
                android:duration="1200" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.7" android:valueTo="1"
                android:duration="1200" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
