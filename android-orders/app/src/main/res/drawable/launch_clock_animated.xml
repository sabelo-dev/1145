<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon: the load animation itself, running from the first frame.
     Same motion as src/brand/loader.html, which picks up from here (LaunchClockPlugin). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_clock">
    <target android:name="minute">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="94.5" android:valueType="floatType"
                    android:duration="450" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="94.5" android:valueTo="454.5" android:valueType="floatType"
                    android:duration="857" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="trail">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="0" android:valueTo="94.5" android:valueType="floatType"
                    android:duration="450" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="94.5" android:valueTo="454.5" android:valueType="floatType"
                    android:duration="857" android:interpolator="@android:interpolator/linear" android:repeatCount="infinite" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="trail_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0" android:valueTo="1" android:valueType="floatType"
                    android:duration="450" android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
    <target android:name="hour">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator android:propertyName="rotation" android:valueFrom="240" android:valueTo="247.875" android:valueType="floatType"
                    android:duration="450" android:interpolator="@android:interpolator/accelerate_quad" />
                <objectAnimator android:propertyName="rotation" android:valueFrom="247.875" android:valueTo="2347.875" android:valueType="floatType"
                    android:duration="60000" android:interpolator="@android:interpolator/linear" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.96" android:valueTo="1.04" android:valueType="floatType"
                    android:duration="1200" android:interpolator="@android:interpolator/accelerate_decelerate" android:repeatCount="infinite" android:repeatMode="reverse" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.96" android:valueTo="1.04" android:valueType="floatType"
                    android:duration="1200" android:interpolator="@android:interpolator/accelerate_decelerate" android:repeatCount="infinite" android:repeatMode="reverse" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="halo_fill">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="fillAlpha" android:valueFrom="0.7" android:valueTo="1" android:valueType="floatType"
                    android:duration="1200" android:interpolator="@android:interpolator/accelerate_decelerate" android:repeatCount="infinite" android:repeatMode="reverse" />
        </aapt:attr>
    </target>
</animated-vector>
